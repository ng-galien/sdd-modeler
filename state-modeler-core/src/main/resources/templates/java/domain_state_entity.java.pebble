package {{ options.packageName }};

import java.time.Instant;
import org.springframework.data.annotation.Id;
import org.springframework.data.relational.core.mapping.Table;
import org.springframework.data.relational.core.mapping.Column;

@Table("{{ entity.name }}_state")
public record {{ entity.className }}DomainState(
    @Id
    @Column("{{ entity.name }}_id")
    {{ entity.id.className }} entityId,
    
    @Column("state_type")
    String stateType,
    
    @Column("state_row_id")
    Long stateRowId,
    
    @Column("state_at")
    Instant stateAt,
    
    @Column("state_json")
    String stateJson
) {
}
