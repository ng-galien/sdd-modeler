{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "DatabaseConfig" : {
      "type" : "object",
      "properties" : {
        "dialect" : {
          "type" : "string"
        },
        "schema" : {
          "type" : "string"
        }
      }
    },
    "Map(String,EntityDef)" : {
      "type" : "object"
    }
  },
  "type" : "object",
  "properties" : {
    "database" : {
      "$ref" : "#/$defs/DatabaseConfig"
    },
    "entities" : {
      "$ref" : "#/$defs/Map(String,EntityDef)"
    },
    "name" : {
      "type" : "string"
    },
    "version" : {
      "type" : "string"
    }
  }
}