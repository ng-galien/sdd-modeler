package {{ options.packageName }};

import org.springframework.transaction.annotation.Transactional;
import java.util.Optional;
{% for import in imports %}
import {{ import }};
{% endfor %}

public class Default{{ entity.className }}Service implements {{ entity.className }}Service {

    {% for state in entity.states %}
    private final {{ state.className }}Repository {{ state.propertyName }}Repository;
    {% endfor %}
    private final {{ entity.className }}DomainStateRepository domainStateRepository;
    private final com.fasterxml.jackson.databind.ObjectMapper objectMapper;

    public Default{{ entity.className }}Service(
        {% for state in entity.states %}
        {{ state.className }}Repository {{ state.propertyName }}Repository,
        {% endfor %}
        {{ entity.className }}DomainStateRepository domainStateRepository,
        com.fasterxml.jackson.databind.ObjectMapper objectMapper
    ) {
        {% for state in entity.states %}
        this.{{ state.propertyName }}Repository = {{ state.propertyName }}Repository;
        {% endfor %}
        this.domainStateRepository = domainStateRepository;
        this.objectMapper = objectMapper;
    }

    @Override
    public java.util.List<{{ entity.className }}State> findAll() {
        var domainStates = domainStateRepository.findAll();
        var states = new java.util.ArrayList<{{ entity.className }}State>();
        for (var ds : domainStates) {
            try {
                Class<? extends {{ entity.className }}State> stateClass = switch(ds.stateType()) {
                    {% for state in entity.states %}
                    case "{{ state.name | upper }}" -> {{ entity.className }}State.{{ state.className }}.class;
                    {% endfor %}
                    default -> throw new IllegalStateException("Unknown state type: " + ds.stateType());
                };
                states.add(objectMapper.readValue(ds.stateJson(), stateClass));
            } catch (Exception e) {
                throw new RuntimeException("Failed to deserialize state", e);
            }
        }
        return states;
    }

    {% for state in entity.states %}
    {% if not state.from.isEmpty() %}
    @Override
    @Transactional
    public {{ entity.className }}Dto transitionTo{{ state.className }}({{ entity.id.className }} id, TransitionTo{{ state.className }}Command command) {
        // Find current state
        {% for source in state.from %}
        Optional<{{ entity.className }}State.{{ source.className }}> source{{ loop.index }} = {{ source.propertyName }}Repository.findById(id);
        if (source{{ loop.index }}.isPresent()) {
            {{ source.propertyName }}Repository.delete(source{{ loop.index }}.get());
        } else 
        {% endfor %}
        {
            throw new IllegalStateException("Entity " + id + " is not in a valid state to transition to {{ state.name }}");
        }

        // Create new state
        var newState = new {{ entity.className }}State.{{ state.className }}(
            id
            {% for attr in state.attributes %}
            , command.{{ attr.propertyName }}()
            {% endfor %}
        );
        {{ state.propertyName }}Repository.save(newState);

        // Return DTO (Note: Stable attributes are not available in State record, passing nulls/defaults)
        return new {{ entity.className }}Dto(
            id
            {% for attr in entity.attributes %}
            , null // TODO: Fetch stable attribute {{ attr.name }}
            {% endfor %}
        );
    }
    {% endif %}
    {% endfor %}
}
