#!/usr/bin/env bash
set -euo pipefail

# pre-push hook: run build and abort push if build fails
# To skip this hook, use: git push --no-verify

echo "Running Gradle build before push..."
./gradlew build
if [ $? -ne 0 ]; then
  echo "Gradle build failed. Aborting push."
  exit 1
fi

echo "Gradle build succeeded. Proceeding with push."
exit 0
