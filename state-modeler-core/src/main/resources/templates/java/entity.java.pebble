package {{ options.packageName | default('com.example') }};

{% if imports is defined %}{% for imp in imports %}import {{ imp }};
{% endfor %}{% endif %}

import org.springframework.data.annotation.Id;
import org.springframework.data.relational.core.mapping.Table;
import org.springframework.data.relational.core.mapping.Column;
import com.fasterxml.jackson.annotation.JsonProperty;

/**
 * Generated ADT for {{ entity.name }} states.
 */
public sealed interface {{ entity.className }}State {

    {% for state in entity.states %}
    /**
     * State: {{ state.name }}
     */
    @Table("{{ state.table }}")
    record {{ state.className }}(
        @Column("{{ state.idColumnName }}") {{ state.idJavaType }} {{ state.idPropertyName }},
        @Id @Column("{{ entity.idColumnName }}") @JsonProperty("{{ entity.idColumnName }}") {{ entity.className }}Id {{ state.entityIdPropertyName }}{% if state.isFromAnyOf is defined and state.isFromAnyOf %},
        @Column("{{ state.previousSourceIdColumnName }}") Integer {{ state.previousSourceIdPropertyName }}{% elseif not state.from.isEmpty() %},
        @Column("{{ state.from[0].previousIdColumnName }}") Integer {{ state.from[0].previousIdPropertyName }}{% endif %}{% if not state.attributes.isEmpty() %}, {% endif %}
        {% for attribute in state.attributes %}
        @Column("{{ attribute.columnName }}") @JsonProperty("{{ attribute.columnName }}") {{ attribute.javaType }} {{ attribute.propertyName }}{% if not loop.last %}, {% endif %}
        {% endfor %}
    ) implements {{ entity.className }}State {
        public {{ state.className }} {
            java.util.Objects.requireNonNull({{ state.entityIdPropertyName }}, "{{ state.entityIdPropertyName }} must not be null");
            {% if state.isFromAnyOf is defined and state.isFromAnyOf %}
            java.util.Objects.requireNonNull({{ state.previousSourceIdPropertyName }}, "{{ state.previousSourceIdPropertyName }} must not be null");
            {% elseif not state.from.isEmpty() %}
            java.util.Objects.requireNonNull({{ state.from[0].previousIdPropertyName }}, "{{ state.from[0].previousIdPropertyName }} must not be null");
            {% endif %}
            {% for attribute in state.attributes %}
            java.util.Objects.requireNonNull({{ attribute.propertyName }}, "{{ attribute.propertyName }} must not be null");
            {% endfor %}
        }
    }
    {% endfor %}
}
