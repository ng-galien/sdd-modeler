package {{ options.packageName | default('com.example') }};

import org.postgresql.util.PGobject;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.jdbc.core.convert.JdbcCustomConversions;
import org.springframework.core.convert.converter.Converter;
import org.springframework.data.convert.ReadingConverter;
import org.springframework.data.convert.WritingConverter;
import java.sql.SQLException;
import java.util.ArrayList;

@Configuration
public class SddConfig {

    @Bean
    public JdbcCustomConversions sddCustomConversions() {
        var converters = new ArrayList<>();
        {% for entity in model.entities %}
        converters.add(new {{ entity.className }}Converters.UuidTo{{ entity.className }}IdConverter());
        converters.add(new {{ entity.className }}Converters.{{ entity.className }}IdToUuidConverter());
        {% endfor %}
        converters.add(new JsonbToStringReadingConverter());
        converters.add(new StringToJsonbWritingConverter());
        return new JdbcCustomConversions(converters);
    }

    // Converters for web/path bindings (String -> Id and Id -> String)
    {% for entity in model.entities %}
    static class StringTo{{ entity.className }}IdConverter implements Converter<String, {{ entity.className }}Id> {
        @Override
        public {{ entity.className }}Id convert(String source) {
            return source == null ? null : {{ entity.className }}Id.fromString(source);
        }
    }

    static class {{ entity.className }}IdToStringConverter implements Converter<{{ entity.className }}Id, String> {
        @Override
        public String convert({{ entity.className }}Id source) {
            return source == null ? null : source.asString();
        }
    }

    @Bean
    public Converter<String, {{ entity.className }}Id> stringTo{{ entity.className }}IdConverter() { return new StringTo{{ entity.className }}IdConverter(); }

    @Bean
    public Converter<{{ entity.className }}Id, String> {{ entity.className | lower }}IdToStringConverter() { return new {{ entity.className }}IdToStringConverter(); }
    {% endfor %}

    @ReadingConverter
    static class JsonbToStringReadingConverter implements Converter<PGobject, String> {
        @Override
        public String convert(PGobject source) {
        return source == null ? null : source.getValue();
        }
    }

    @WritingConverter
    static class StringToJsonbWritingConverter implements Converter<String, PGobject> {
        @Override
        public PGobject convert(String source) {
            if (source == null) return null;
            PGobject pg = new PGobject();
            pg.setType("jsonb");
            try {
                pg.setValue(source);
            } catch (SQLException e) {
                throw new IllegalArgumentException("Invalid JSON", e);
            }
            return pg;
        }
    }
}
