package {{ options.packageName }};

import org.springframework.transaction.annotation.Transactional;
import java.util.Optional;
{% for import in imports %}
import {{ import }};
{% endfor %}

public class Default{{ entity.className }}Service implements {{ entity.className }}Service {

    {% for state in entity.states %}
    private final {{ state.className }}Repository {{ state.propertyName }}Repository;
    {% if state.isFromAnyOf is defined and state.isFromAnyOf %}
    private final {{ state.sourceTableRepositoryName }} {{ state.sourceTablePropertyName }}Repository;
    {% endif %}
    {% endfor %}
    private final {{ entity.className }}DomainStateRepository domainStateRepository;
    private final com.fasterxml.jackson.databind.ObjectMapper objectMapper;

    public Default{{ entity.className }}Service(
        {% for state in entity.states %}
        {{ state.className }}Repository {{ state.propertyName }}Repository,
        {% if state.isFromAnyOf is defined and state.isFromAnyOf %}
        {{ state.sourceTableRepositoryName }} {{ state.sourceTablePropertyName }}Repository,
        {% endif %}
        {% endfor %}
        {{ entity.className }}DomainStateRepository domainStateRepository,
        com.fasterxml.jackson.databind.ObjectMapper objectMapper
    ) {
        {% for state in entity.states %}
        this.{{ state.propertyName }}Repository = {{ state.propertyName }}Repository;
        {% if state.isFromAnyOf is defined and state.isFromAnyOf %}
        this.{{ state.sourceTablePropertyName }}Repository = {{ state.sourceTablePropertyName }}Repository;
        {% endif %}
        {% endfor %}
        this.domainStateRepository = domainStateRepository;
        this.objectMapper = objectMapper;
    }

        @Override
        public java.util.List<{{ entity.className }}StateInfo> findAll() {
        var domainStates = domainStateRepository.findAll();
                var states = new java.util.ArrayList<{{ entity.className }}StateInfo>();
        for (var ds : domainStates) {
            try {
                Class<? extends {{ entity.className }}State> stateClass = switch(ds.stateType()) {
                    {% for state in entity.states %}
                    case "{{ state.name | upper }}" -> {{ entity.className }}State.{{ state.className }}.class;
                    {% endfor %}
                    default -> throw new IllegalStateException("Unknown state type: " + ds.stateType());
                };
                var state = objectMapper.readValue(ds.stateJson(), stateClass);
                states.add(new {{ entity.className }}StateInfo(ds.stateType(), state));
            } catch (Exception e) {
                throw new RuntimeException("Failed to deserialize state", e);
            }
        }
        return states;
    }

    {% for state in entity.states %}
    {% if not state.from.isEmpty() %}
    @Override
    @Transactional
    public {{ entity.className }}Dto transitionTo{{ state.className }}({{ entity.id.className }} id, TransitionTo{{ state.className }}Command command) {
        {% if state.isFromAnyOf is defined and state.isFromAnyOf %}
        // from_any_of transition: verify current state via domain state, then create source record
        var domainState = domainStateRepository.findById(id)
            .orElseThrow(() -> new IllegalStateException("Entity " + id + " not found"));
        java.util.Set<String> validSources = java.util.Set.of({% for source in state.from %}"{{ source.name | upper }}"{% if not loop.last %}, {% endif %}{% endfor %});
        if (!validSources.contains(domainState.stateType())) {
            throw new IllegalStateException("Entity " + id + " is in state " + domainState.stateType() + " which cannot transition to {{ state.name }}");
        }

        // Find source state record based on current state
        {{ state.sourceTableClassName }} sourceRecord = null;
        {% for source in state.from %}
        if ("{{ source.name | upper }}".equals(domainState.stateType())) {
            Optional<{{ entity.className }}State.{{ source.className }}> source{{ loop.index }} = {{ source.propertyName }}Repository.findById(id);
            if (source{{ loop.index }}.isPresent()) {
                Integer sourceStateId = source{{ loop.index }}.get().id();
                sourceRecord = {{ state.sourceTableClassName }}.from{{ source.className }}(id, sourceStateId);
            }
        }
        {% endfor %}
        if (sourceRecord == null) {
            throw new IllegalStateException("Entity " + id + " source state record not found");
        }

        // Save source record (source state is preserved for referential integrity)
        var savedSource = {{ state.sourceTablePropertyName }}Repository.save(sourceRecord);
        Integer previousSourceId = savedSource.id();

        // Create new state with reference to source record
        var newState = new {{ entity.className }}State.{{ state.className }}(
            null, id, previousSourceId
            {% for attr in state.attributes %}
            , command.{{ attr.propertyName }}()
            {% endfor %}
        );
        {% else %}
        // Simple transition: capture previous state id directly
        Integer previousStateId = null;
        {% for source in state.from %}
        Optional<{{ entity.className }}State.{{ source.className }}> source{{ loop.index }} = {{ source.propertyName }}Repository.findById(id);
        if (source{{ loop.index }}.isPresent()) {
            previousStateId = source{{ loop.index }}.get().id();
            {{ source.propertyName }}Repository.delete(source{{ loop.index }}.get());
        }
        {% endfor %}
        if (previousStateId == null) {
            throw new IllegalStateException("Entity " + id + " is not in a valid state to transition to {{ state.name }}");
        }

        // Create new state with reference to previous state
        var newState = new {{ entity.className }}State.{{ state.className }}(
            null, id, previousStateId
            {% for attr in state.attributes %}
            , command.{{ attr.propertyName }}()
            {% endfor %}
        );
        {% endif %}
        {{ state.propertyName }}Repository.save(newState);

        // Return DTO (entity attributes are not available from state record)
        return new {{ entity.className }}Dto(
            id
            {% for attr in entity.attributes %}
            , null
            {% endfor %}
        );
    }
    {% endif %}
    {% endfor %}
}
