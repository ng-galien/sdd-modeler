package {{ options.packageName | default('com.example') }};

import org.springframework.core.convert.converter.Converter;
import org.springframework.data.convert.ReadingConverter;
import org.springframework.data.convert.WritingConverter;
import java.util.UUID;

public class {{ entity.className }}Converters {

    @ReadingConverter
    public static class UuidTo{{ entity.className }}IdConverter implements Converter<UUID, {{ entity.className }}Id> {
        @Override
        public {{ entity.className }}Id convert(UUID source) {
            return new {{ entity.className }}Id(source);
        }
    }

    @WritingConverter
    public static class {{ entity.className }}IdToUuidConverter implements Converter<{{ entity.className }}Id, UUID> {
        @Override
        public UUID convert({{ entity.className }}Id source) {
            return source.value();
        }
    }
}
