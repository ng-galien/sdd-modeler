package {{ options.packageName | default('com.example') }};

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.jdbc.core.convert.JdbcCustomConversions;
import java.util.List;
import java.util.ArrayList;

@Configuration
public class SddConfig {

    @Bean
    public JdbcCustomConversions sddCustomConversions() {
        var converters = new ArrayList<>();
        {% for entity in model.entities %}
        converters.add(new {{ entity.className }}Converters.UuidTo{{ entity.className }}IdConverter());
        converters.add(new {{ entity.className }}Converters.{{ entity.className }}IdToUuidConverter());
        {% endfor %}
        return new JdbcCustomConversions(converters);
    }
}
